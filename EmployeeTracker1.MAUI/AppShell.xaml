<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EmployeeTracker1.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EmployeeTracker1.MAUI.Views"
    xmlns:local="clr-namespace:EmployeeTracker1.MAUI"
    Shell.FlyoutBehavior="Disabled"
    Title="EmployeeTracker1.MAUI">

    <ShellContent Route="LoginPage" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="DashboardPage" ContentTemplate="{DataTemplate views:DashboardPage}" />
    <ShellContent Route="UnlockReasonPage" ContentTemplate="{DataTemplate views:UnlockReasonPage}" />

</Shell>
