<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EmployeeTracker1.MAUI.Views.LoginPage"
             Title="Login"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Padding="30" Spacing="20"
                         VerticalOptions="Center">

        <Label Text="Login"
               FontSize="Title"
               HorizontalOptions="Center"/>

        <Frame Style="{StaticResource CommonFrameStyle}">
            <Entry Placeholder="Email" Text="{Binding Email}" Style="{StaticResource CommonEntryStyle}"/>
        </Frame>

        <Frame Style="{StaticResource CommonFrameStyle}">
            <Entry Placeholder="Password" Text="{Binding Password}" Style="{StaticResource CommonEntryStyle}" />
        </Frame>

        <Button Text="Login"
                Command="{Binding LoginCommand}"
                Style="{StaticResource CommonButtonStyle}"/>

    </VerticalStackLayout>
</ContentPage>
