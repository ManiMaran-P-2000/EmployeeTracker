<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EmployeeTracker1.MAUI.Views.DashboardPage"
             Title="DashboardPage">
    <VerticalStackLayout Padding="20">
        <Label Text="{Binding WelcomeMessage}" FontSize="Large" HorizontalOptions="Center"/>
        <Button Text="Start Tracking" Command="{Binding StartTrackingCommand}" />
        <Button Text="Cancel Tracking" Command="{Binding StopTrackingCommand}" />
    </VerticalStackLayout>
</ContentPage>