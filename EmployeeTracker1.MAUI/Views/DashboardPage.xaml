<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EmployeeTracker1.MAUI.Views.DashboardPage"
             Title="DashboardPage">
    
    <VerticalStackLayout  Padding="30" Spacing="20"
                         VerticalOptions="Center">
        
        <Label Text="{Binding WelcomeMessage}" FontSize="Title" HorizontalOptions="Center"/>
        <Label Text="{Binding ElapsedTime, StringFormat='Elapsed Time: {0:hh\\:mm\\:ss}'}" FontSize="Large" HorizontalOptions="Center" />
        <Button Text="Start Tracking" Command="{Binding StartTrackingCommand}" Style="{StaticResource CommonButtonStyle}" />
        <Button Text="Cancel Tracking" Command="{Binding StopTrackingCommand}" Style="{StaticResource CommonButtonStyle}" />
    </VerticalStackLayout>
</ContentPage>