<Window x:Class="EmployeeTrackerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Unlock Reason" 
      WindowStyle="None"
      ResizeMode="NoResize"
      WindowStartupLocation="CenterScreen"
      Topmost="True"
      Width="800" Height="700"
      Background="White"
      ShowInTaskbar="False"
      >

    <Grid Margin="20">
        <TextBlock Text="Please provide a reason for unlocking:" 
                   FontSize="14" FontWeight="Bold" 
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"/>
        <StackPanel VerticalAlignment="Center">

            <!-- Dropdown for Reason Selection -->
            <TextBlock Text="Select a reason:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox Name="ReasonDropdown" Width="300" Height="30">
                <ComboBoxItem Content="Break"/>
                <ComboBoxItem Content="Meeting"/>
                <ComboBoxItem Content="Technical Issue"/>
                <ComboBoxItem Content="Personal Work"/>
                <ComboBoxItem Content="Other"/>
            </ComboBox>

            <!-- TextArea for Additional Details -->
            <TextBlock Text="Additional details (optional):" FontWeight="Bold" Margin="0,10,0,5"/>
            <TextBox Name="AdditionalDetails" Width="300" Height="80" 
                     TextWrapping="Wrap" AcceptsReturn="True"/>

            <!-- Submit Button -->
            <Button Content="Submit"
                    Width="100" Height="30" Margin="0,10,0,0"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>